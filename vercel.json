{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python -c \"from pathlib import Path; import runpy, shutil; p=Path('scripts/build_vercel_site.py'); runpy.run_path(str(p), run_name='__main__') if p.exists() else (Path('dist-vercel').mkdir(parents=True, exist_ok=True), shutil.copy2('index.html', 'dist-vercel/index.html'))\"",
  "outputDirectory": "dist-vercel",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/silt",
      "destination": "https://silt.inbharat.ai/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*\\.md)", "destination": "/$1" },
    { "source": "/web/(.*)", "destination": "/web/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.md)",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/web/studio-bridge.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" }
      ]
    }
  ]
}
