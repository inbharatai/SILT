              "PHP",
              "bigdata"
            ]
          ],
          "kwargs": {},
          "expected": 7,
          "id": "io_1",
          "upstream_assertion": "assert len_log([\"python\",\"PHP\",\"bigdata\"]) == 7"
        },
        {
          "function": "len_log",
          "args": [
            [
              "a",
              "ab",
              "abc"
            ]
          ],
          "kwargs": {},
          "expected": 3,
          "id": "io_2",
          "upstream_assertion": "assert len_log([\"a\",\"ab\",\"abc\"]) == 3"
        },
        {
          "function": "len_log",
          "args": [
            [
              "small",
              "big",
              "tall"
            ]
          ],
          "kwargs": {},
          "expected": 5,
          "id": "io_3",
          "upstream_assertion": "assert len_log([\"small\",\"big\",\"tall\"]) == 5"
        }
      ]
    },
    {
