          "id": "io_1",
          "upstream_assertion": "assert capital_words_spaces(\"Python\") == 'Python'"
        },
        {
          "function": "capital_words_spaces",
          "args": [
            "PythonProgrammingExamples"
          ],
          "kwargs": {},
          "expected": "Python Programming Examples",
          "id": "io_2",
          "upstream_assertion": "assert capital_words_spaces(\"PythonProgrammingExamples\") == 'Python Programming Examples'"
        },
        {
          "function": "capital_words_spaces",
          "args": [
            "GetReadyToBeCodingFreak"
          ],
          "kwargs": {},
          "expected": "Get Ready To Be Coding Freak",
          "id": "io_3",
          "upstream_assertion": "assert capital_words_spaces(\"GetReadyToBeCodingFreak\") == 'Get Ready To Be Coding Freak'"
        }
      ]
    },
    {
