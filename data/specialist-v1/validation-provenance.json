    {
      "id": "mbpp_591",
      "function_cases": [
        {
          "function": "swap_List",
          "args": [
            [
              12,
              35,
              9,
              56,
              24
            ]
          ],
          "kwargs": {},
          "expected": [
            24,
            35,
            9,
            56,
            12
          ],
          "id": "io_1",
          "upstream_assertion": "assert swap_List([12, 35, 9, 56, 24]) == [24, 35, 9, 56, 12]"
        },
        {
          "function": "swap_List",
          "args": [
            [
              1,
              2,
              3
            ]
          ],
          "kwargs": {},
          "expected": [
            3,
            2,
            1
          ],
          "id": "io_2",
          "upstream_assertion": "assert swap_List([1, 2, 3]) == [3, 2, 1]"
        },
        {
          "function": "swap_List",
          "args": [
            [
              4,
              5,
              6
            ]
          ],
          "kwargs": {},
          "expected": [
            6,
            5,
            4
          ],
          "id": "io_3",
          "upstream_assertion": "assert swap_List([4, 5, 6]) == [6, 5, 4]"
        }
      ]
    },
