      "function_cases": [
        {
          "function": "noprofit_noloss",
          "args": [
            1500,
            1200
          ],
          "kwargs": {},
          "expected": false,
          "id": "io_1",
          "upstream_assertion": "assert noprofit_noloss(1500,1200)==False"
        },
        {
          "function": "noprofit_noloss",
          "args": [
            100,
            100
          ],
          "kwargs": {},
          "expected": true,
          "id": "io_2",
          "upstream_assertion": "assert noprofit_noloss(100,100)==True"
        },
        {
          "function": "noprofit_noloss",
          "args": [
            2000,
            5000
          ],
          "kwargs": {},
          "expected": false,
          "id": "io_3",
          "upstream_assertion": "assert noprofit_noloss(2000,5000)==False"
        }
      ]
    },
