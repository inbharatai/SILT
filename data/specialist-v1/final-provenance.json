      "id": "mbpp_602",
      "function_cases": [
        {
          "function": "first_repeated_char",
          "args": [
            "abcabc"
          ],
          "kwargs": {},
          "expected": "a",
          "id": "io_1",
          "upstream_assertion": "assert first_repeated_char(\"abcabc\") == \"a\""
        },
        {
          "function": "first_repeated_char",
          "args": [
            "abc"
          ],
          "kwargs": {},
          "expected": null,
          "id": "io_2",
          "upstream_assertion": "assert first_repeated_char(\"abc\") == None"
        },
        {
          "function": "first_repeated_char",
          "args": [
            "123123"
          ],
          "kwargs": {},
          "expected": "1",
          "id": "io_3",
          "upstream_assertion": "assert first_repeated_char(\"123123\") == \"1\""
        }
      ]
    },
